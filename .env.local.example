# ── Database: Neon Postgres ───────────────────────────────
# Pooled connection string from the Neon console (Connection Details → "Pooled").
# Keep ?sslmode=require. Used by both the app (Drizzle) and drizzle-kit.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require

# ── Auth: Better Auth ─────────────────────────────────────
# Secret for signing sessions/tokens. Generate: openssl rand -base64 32
BETTER_AUTH_SECRET=your-32+-char-random-secret
# Public base URL of the app (no trailing slash). Locally: http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000

# ── Email: SMTP (Strato) — verification + password reset ──
# Optional locally: without these the mail is printed to the console instead of
# being sent, so registration works without a mailbox. In production they are
# required — email verification is mandatory (requireEmailVerification: true).
#
# Either set ALL of HOST/USER/PASSWORD/FROM or none — a half-configured
# transport is rejected by the env schema.
#
# Port 465 = implicit TLS, 587 = STARTTLS. SMTP_USER is the full address, the
# password is the mailbox password (not the Strato customer login). EMAIL_FROM
# must match the authenticated mailbox or Strato rejects the mail with 550.
SMTP_HOST=smtp.strato.de
SMTP_PORT=465
SMTP_USER=info@your-domain.de
SMTP_PASSWORD=your-mailbox-password
EMAIL_FROM=Bilanz-Buddy <info@your-domain.de>

# ── Admin (comma-separated emails) ────────────────────────
ADMIN_EMAILS=admin@example.com

# ── Stripe (subscriptions) ────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Price ID of the Bilanz-Buddy Pro subscription (19,90 €/month). Create a recurring
# monthly Price on a Stripe product and paste its price_… id here. Without it the
# checkout returns 500 (billing not configured).
STRIPE_PRICE_ID=price_...

# ── Arcjet (rate limiting / security) ─────────────────────
# Optional locally; REQUIRED in production — without it the middleware fails closed
# and returns 503 for all requests (see src/proxy.ts).
ARCJET_KEY=ajkey_...

# ── Referral slots (Phase 3.3+/4.4; public, client-visible) ───
# Optional affiliate placements, each marked "Anzeige" (UWG). A slot is only
# shown when its URL is set. No user data is sent to the partner.
# SumUp card reader (market mode) — falls back to the SumUp homepage if unset.
NEXT_PUBLIC_SUMUP_REFERRAL_URL=https://www.sumup.com/de-de/
# Trade liability insurance comparison (settings) — hidden if unset.
NEXT_PUBLIC_INSURANCE_REFERRAL_URL=

# Schuetzt /api/cron/retention (Loeschung abgelaufener Rechnungsarchive).
# In Vercel unter Settings -> Environment Variables setzen; Vercel Cron sendet
# den Wert als "Authorization: Bearer ...".
CRON_SECRET=

# ── Betriebsalarme ────────────────────────────────────────
# Zieladresse des Backup-Waechters: meldet, wenn die naechtliche Sicherung
# laenger als 36 h ausgeblieben ist (docs/backup-runbook.md). Muss auch in
# Vercel (Production) gesetzt sein — und danach EINMAL neu deployen, sonst
# laeuft der Waechter weiter mit leerem Wert und loggt nur.
# Denselben Wert zusaetzlich als GitHub-Actions-Secret hinterlegen.
ALERT_EMAIL_TO=
