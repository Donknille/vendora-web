# ── Database: Neon Postgres ───────────────────────────────
# Pooled connection string from the Neon console (Connection Details → "Pooled").
# Keep ?sslmode=require. Used by both the app (Drizzle) and drizzle-kit.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require

# ── Auth: Better Auth ─────────────────────────────────────
# Secret for signing sessions/tokens. Generate: openssl rand -base64 32
BETTER_AUTH_SECRET=your-32+-char-random-secret
# Public base URL of the app (no trailing slash). Locally: http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000

# ── Email: Resend (password reset + verification) ─────────
# Optional locally (emails are skipped with a warning if unset); required for
# password reset in production. Verify a domain in Resend for real recipients.
RESEND_API_KEY=re_...
EMAIL_FROM=Vendora <noreply@your-domain.de>

# ── Admin (comma-separated emails) ────────────────────────
ADMIN_EMAILS=admin@example.com

# ── Stripe (subscriptions) ────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Price ID of the Vendora Pro subscription (19,90 €/month). Create a recurring
# monthly Price on a Stripe product and paste its price_… id here. Without it the
# checkout returns 500 (billing not configured).
STRIPE_PRICE_ID=price_...

# ── Arcjet (rate limiting / security) ─────────────────────
# Optional locally; REQUIRED in production — without it the middleware fails closed
# and returns 503 for all requests (see src/proxy.ts).
ARCJET_KEY=ajkey_...

# ── Referral slots (Phase 3.3+/4.4; public, client-visible) ───
# Optional affiliate placements, each marked "Anzeige" (UWG). A slot is only
# shown when its URL is set. No user data is sent to the partner.
# SumUp card reader (market mode) — falls back to the SumUp homepage if unset.
NEXT_PUBLIC_SUMUP_REFERRAL_URL=https://www.sumup.com/de-de/
# Trade liability insurance comparison (settings) — hidden if unset.
NEXT_PUBLIC_INSURANCE_REFERRAL_URL=

# Schuetzt /api/cron/retention (Loeschung abgelaufener Rechnungsarchive).
# In Vercel unter Settings -> Environment Variables setzen; Vercel Cron sendet
# den Wert als "Authorization: Bearer ...".
CRON_SECRET=
